DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=hotel-api.onrender.com
DATABASE_URL=postgresql://user:password@host:5432/hotel_database
# Local host connection when PostgreSQL is started by docker compose:
# DATABASE_URL=postgresql://hotel:hotel@127.0.0.1:5433/hotel_platform
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGINS=https://hotel-platform.vercel.app
CSRF_TRUSTED_ORIGINS=https://hotel-platform.vercel.app
HOTEL_NAME=The Grand Stay Hotel
HOTEL_SHORT_NAME=Grand Stay
HOTEL_TIMEZONE=Africa/Kampala
BOOTSTRAP_ADMIN_EMAIL=owner@hotel.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name
CLOUDINARY_FOLDER=hotel-platform
